<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Old appointments</title>
  
  <link rel="stylesheet" href="/css/vendor/bootstrap-5.3.3.min.css" />
  <link rel="stylesheet" href="/css/oldAppointment.css">
  <link rel="stylesheet" href="/css/vendor/fontawesome-5.15.4.min.css">
  
  
  <script src="/js/vendor/jquery.min.js"></script>
</head>

<body>
  <header>
    <%-include('_header')%>
  </header>
  <div class="search-div">
    <input id="selectedDate" range style="width: 15%; height: 75%; font-size: larger; margin-top: .3%" type="date"
      name="" id="">
    <button onclick="getAppointments()" class="btn" style="background-color:#025E73; width:15%;margin-right: 25px;"><i class="fas fa-search"></i> Search</button>
    <input type="checkbox" name="" id="ShowHideDisabled" onchange="getAppointments()" style="margin-right: 5px;">Show Disabled Appointments
  </div>
  
  <table class="table table-striped table-bordered text-center">
    <thead>
      <tr class="bg">
        <th scope="col">#</th>
        <th scope="col"><i class="fa-solid fa-stethoscope"></i> Dr.Name</th>
        <th scope="col"><i class="fas fa-user"></i> Name</th>
        <th scope="col"><i class="fa-solid fa-people-group"></i> Age</th>
        <th scope="col"><i class="fa-solid fa-venus-mars"></i> Gender</th>
        <th scope="col"><i class="fas fa-map-marker-alt"></i> Address</th>
        <th scope="col">₹ Fees</th>
        <th scope="col"><i class="fa-solid fa-notes-medical"></i></i> History</th>
        <th scope="col"><i class="fa-regular fa-file-powerpoint"></i> Prescription</th>
        <th><i class="fa-solid fa-square-check"></i> Status</th>
        <!--
        <th><i class="fa-solid fa-prescription"></i> Prescription</th>
        -->
      </tr>
    </thead>
    <%-include('_loader')%>
    <tbody id="table-body">

    </tbody>
  </table>
  <script src="/js/oldAppointment.js"></script>
</body>

</html>