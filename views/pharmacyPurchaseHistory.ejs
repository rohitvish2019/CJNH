<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pharmacy Purchase History</title>
    <link rel="stylesheet" href="/css/vendor/bootstrap-5.3.3.min.css">
    <link rel="stylesheet" href="/css/vendor/fontawesome-5.15.4.min.css">
    <link rel="stylesheet" href="/css/purchasesHistory.css">
</head>
<body>
    <header><%-include('_header')%></header>
    <main class="main-body">
        <div class="heading"><h4>Pharmacy Purchase History</h4></div>
        <form id="historySearch" class="searchElements" style="display:flex;justify-content:flex-start;gap:10px;align-items:center;flex-wrap:wrap;">
            <label for="startDate"><b>From</b></label>
            <input type="date" id="startDate" required>
            <label for="endDate"><b>To</b></label>
            <input type="date" id="endDate" required>
            <select id="medicineName"><option value="All">All Medicines</option><% inventory.forEach(function(name){ %><option value="<%=name%>"><%=name%></option><% }); %></select>
            <select id="supplier"><option value="All">All Suppliers</option><% suppliers.forEach(function(name){ %><option value="<%=name%>"><%=name || 'Unknown'%></option><% }); %></select>
            <button class="btn btn-success" type="submit"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
            <b id="total"></b>
        </form>
        <div class="table-body">
            <table class="table table-striped table-bordered">
                <thead><tr class="bg"><th>#</th><th>Medicine</th><th>Batch No</th><th>Expiry Date</th><th>Purchase Price</th><th>Selling Price</th><th>Quantity</th><th>Total</th><th>Purchased Date</th><th>Supplier</th><th>Category</th></tr></thead>
                <tbody id="pharmacyPurchases"><tr><td colspan="11">Search to view pharmacy purchase history.</td></tr></tbody>
            </table>
        </div>
    </main>
    <script src="/js/pharmacyPurchaseHistory.js"></script>
</body>
</html>
