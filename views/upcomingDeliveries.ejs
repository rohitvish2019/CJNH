<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upcoming Deliveries</title>
  <link rel="stylesheet" href="/css/vendor/fontawesome-5.15.4.min.css">
  <link rel="stylesheet" href="/css/upcomingDeliveries.css">
</head>

<body>
  <header>
    <%-include('_header')%>
    <%-include('_loader')%>
  </header>

  <div style="padding: 1% 4% 0;">
    <div style="display: flex; justify-content: flex-end; align-items: center; gap: 10px; margin-bottom: 10px;">
      <span id="summaryCounts" class="badge-group" style="font-size: 14px; font-weight: 600; color: #333; margin-right: auto; display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
        <span class="badge badge-success" style="padding: 6px 10px; font-size: 13px;">Delivered: <strong id="deliveredCount">0</strong></span>
        <span class="badge badge-warning" style="padding: 6px 10px; font-size: 13px; color: #333; background-color: #fff3cd;">Pending: <strong id="pendingCount">0</strong></span>
        <span class="badge badge-danger" style="padding: 6px 10px; font-size: 13px;">Due: <strong id="dueCount">0</strong></span>
      </span>
      <label for="startDate"><b>Start Date</b></label>
      <input id="startDate" type="date" class="form-control" style="width: auto;">
      <label for="endDate"><b>End Date</b></label>
      <input id="endDate" type="date" class="form-control" style="width: auto;">
      <button id="searchDeliveriesBtn" class="btn btn-success"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
      <label id="deliveryCount"></label>
    </div>
  </div>

  <table class="table table-bordered" style="margin: 8px 0;">
    <caption>Upcoming Deliveries</caption>
    <thead>
      <tr class="bg">
        <th scope="col">#</th>
        <th scope="col"><i class="fa-solid fa-id-badge"></i> Id</th>
        <th scope="col"><i class="fas fa-user"></i> Name</th>
        <th scope="col">Age</th>
        <th scope="col">Mobile</th>
        <th scope="col"><i class="fa-solid fa-stethoscope"></i> Doctor</th>
        <th scope="col">C.EDD</th>
        <th scope="col">Delivery Status</th>
        <th scope="col"><i class="fas fa-map-marker-alt"></i> Address</th>
        <th scope="col">Profile</th>
      </tr>
    </thead>
    <tbody id="tableBody"></tbody>
  </table>

  <script src="/js/upcomingDeliveries.js"></script>
</body>
</html>
