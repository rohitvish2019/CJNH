<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Medicine Inventory</title>
<script src="/js/vendor/noty-3.1.4.min.js"></script>
<link rel="stylesheet" href="/css/vendor/noty-3.1.4.min.css" />
<script src="/js/vendor/jquery.min.js"></script>

<link rel="stylesheet" href="/css/purchasesHistory.css">
</head>
<body>
    <header>
        <%-include('_header')%>
    </header>
    <div class="main-body">
        <div class="heading">
            <h2>Returned Inventories</h2>
        </div>
        <div class="searchElements" style="display: flex;justify-content: space-between;margin-right: 2%;">
            <div>
                <label for=""><b>Return Date Range : </b>&nbsp;</label>
                <input type="date" name="" id="startDate">
                <input type="date" name="" id="endDate">
                <select name="" id="returnType">
                    <option value="vendor">To Vendor</option>
                    <option value="patients">From Patients</option>
                </select>
                <button class="btn btn-success" onclick="getReturnsHistory()">Search</button>
            </div>
            <div>
                <b id="tvalue"></b>
            </div>
        </div>
        <div class="table-body" style="overflow: auto;">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Medicine</th>
                        <th>Batch No</th>
                        <th>Qty returned</th>
                        <th>Expiry Date</th>
                        <th>Price</th>
                        <th>Total Value</th>
                        <th>Return Date</th>
                    </tr>
                </thead>
                <%-include('_loader')%>
                <tbody id="medicines">
                    <!-- Table rows will be populated dynamically -->
                    
                </tbody>
            </table>
        </div>
        <div class="pagination-box">
            <ul class="pagination" id="pagination">
                <!-- Pagination buttons will be populated dynamically -->
            </ul>
        </div>
    </div>
    
<script src="/js/returnHistory.js"></script>
</body>
</html>
