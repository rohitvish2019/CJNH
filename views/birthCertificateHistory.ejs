<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Birth Certificates</title>
    <script src="/js/vendor/noty-3.1.4.min.js"></script>
    <link rel="stylesheet" href="/css/vendor/noty-3.1.4.min.css" />
    <link rel="stylesheet" href="/css/vendor/fontawesome-5.15.4.min.css">
    <script src="/js/vendor/jquery.min.js"></script>

    <link rel="stylesheet" href="/css/purchasesHistory.css">
</head>

<body>
    <header>
        <%-include('_header')%>
    </header>
    <div class="main-body">
        <div class="heading">
            <h2>Find Birth Certificates</h2>
        </div>
        <div class="searchElements text-center py-1 d-flex align-items-center">
            
            <div style="margin-right: 2%;margin-top: 2px;">
                <label for=""><b>Filter type : </b>&nbsp;</label>
                <select name="" id="filterType" onchange="changeInputs()" style="height: 70%;">
                    <!--
                    <option value="byDate" selected>Exact Date</option>
                    -->
                    <option value="byDateRange">Date Range</option>
                    
                    <option value="byId">By Id</option>
                </select>
            </div>

            <div id="dateRangeInputs" style="margin-right: 2%;">
                <label for=""><b>Generated between : </b>&nbsp;</label>
                <input type="date" name="" id="startDate">
                <input type="date" name="" id="endDate">
            </div>
            <div id="dateInput" style="margin-right: 2%; margin-top: 2px;">
                <label for=""><b>Generated on : </b>&nbsp;</label>
                <input type="date" name="" id="selectedDate">
            </div>
            <div id="idInput">
                <input type="number" placeholder="Enter OPD Id" id="idToSearch">
            </div>
            
            <button class="btn btn-success" style="margin-bottom: 0.5%;"
                onclick="getBirthHistory()">Search</button>
            <b style="margin-left: 3%;" id="tvalue"></b>
            
            
            
            <div>
                <b id="tvalue"></b>
            </div>

        </div>

        <div class="table-body" style="overflow: auto;">
            <table class="table table-striped table-bordered text-center">
                <thead>
                    <tr class="bg">
                        <th>#</th>
                        <th><i class="fas fa-user"></i> Patient Name</th>
                        <th><i class="fas fa-user"></i> Id</th>
                        <th><i class="fa-solid fa-book-medical"></i> Age</th>
                        <th><i class="fa-regular fa-calendar"></i> Certificate</th>
                        <th><i class="fa-regular fa-calendar"></i> Child DOB</th>
                        <th><i class="fa-regular fa-calendar"></i> Action</th>
                    </tr>
                </thead>
                <%-include('_loader')%>
                <tbody id="historyBody">
                    <!-- Table rows will be populated dynamically -->
                </tbody>
            </table>
        </div>

        <style>

        </style>

        <div class="pagination-box">
            <ul class="pagination" id="pagination">
                <!-- Pagination buttons will be populated dynamically -->
            </ul>
        </div>
    </div>

    <script src="/js/birthCertificateHistory.js"></script>
</body>

</html>