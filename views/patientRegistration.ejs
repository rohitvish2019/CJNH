<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Patient Registration</title>
  <link rel="stylesheet" href="/css/patientRegistration.css">
  <script src="/js/vendor/noty-3.1.4.min.js"></script>
  <link rel="stylesheet" href="/css/vendor/noty-3.1.4.min.css" />
  <script src="/js/vendor/jquery.min.js"></script>
  <link rel="stylesheet" href="/css/vendor/bootstrap-5.3.3.min.css" />
  <script src="/js/patientRegistration.js"></script>
  
  <link rel="stylesheet" href="/css/vendor/fontawesome-5.15.4.min.css">

</head>

<body>

  <header>
    <%-include('_header')%>
  </header>

  <section class="main-content">

    <div id="registrationForm">
      <h4><i class="fa-solid fa-id-card"></i> OPD Registration Form</h4>

      <div class="Container" style="display: flex;">
        <div class="left">
          <div class="Searchbar mb-2" style="display: flex; height: 38px;">
            <input type="text" id="patientID" style="display: inline-block; height: 100%; width: 72% "
              class="form-control" placeholder="Search with Mobile or Id" aria-label="Recipient's username"
              aria-describedby="basic-addon2">

            <button class="btn" style="margin-left: 3.5%; background-color:#025E73" type="button"
              onclick="searchById()"><i class="fas fa-search"></i></button>
          </div>
          <div class="form-floating mb-2">
            <input type="text" class="form-control" id="Name" placeholder="name@example.com">
            <label for="Name"><i class="fas fa-user"></i> Full Name <span>*</span></label>
          </div>

          <div class="form-floating mb-2">
            <select class="form-select" id="Gender" aria-label="Floating label select example">
              <option value="Male"><i class="fa-solid fa-mars"></i> ♂️ Male</option>
              <option value="Female" selected>♀️ Female</option>
              <option value="Other">⚧︎ Other</option>
            </select>
            <label for="Gender"> Gender <span>*</span></label>
          </div>

          <div class="form-floating mb-2">
            <input type="number" class="form-control" id="Age" placeholder="name@example.com">
            <label for="Age"><i class="fa-solid fa-arrow-up-1-9"></i> Age <span>*</span></label>
          </div>
          <div class="form-floating mb-2">
            <input type="text" class="form-control" id="Address" placeholder="name@example.com">
            <label for="Address"><i class="fas fa-map-marker-alt"></i> Address <span>*</span></label>
          </div>
          <div class="form-floating mb-2">
            <% if(user.Role == 'Admin' ) {%>
                <input type="number" class="form-control" id="Fees" placeholder="name@example.com" value="<%= new Date().getDay() == 0 ? 700 : 500%>">
            <%} else {%>
              <input type="number" class="form-control" id="Fees" placeholder="name@example.com" value="<%= new Date().getDay() == 0 ? 700 : 500%>">
            <%}%>
            
            <label for="Mobile"> <b>₹</b> Fees<span>*</span></label>
          </div>
          <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="emergencyBooking" onchange="setFees()">
            <label class="form-check-label" for="emergencyBooking">Emergency Booking</label>
          </div>
          <div style="text-align: left; font-size: 12px;">
            <span>* Mandatory Details</span>
          </div>
        </div>

        <div class="right">
          <select class="form-select mb-2" id="Doctor" aria-label="Floating label select example">
            <option selected disabled value="">--Select Doctor--</option>
            <% for (let i = 0; i < hospitalConfig.doctors.length; i++) { %>
              <option value="<%= hospitalConfig.doctors[i].name %>"><%= hospitalConfig.doctors[i].name %></option>
            <% } %>
          </select>
          <div class="form-floating mb-2">
            <input type="text" class="form-control mb2" id="Husband" placeholder="name@example.com">
            <label for="Mobile"><i class="fa-solid fa-user"></i> Husband's Name <span>*</span></label>
          </div>
          <div class="form-floating mb-2">
            <input type="text" class="form-control mb2" id="Father" placeholder="name@example.com">
            <label for="Father"><i class="fa-solid fa-user"></i> Father's Name</label>
          </div>
          <div class="form-floating mb-2">
            <input type="text" class="form-control mb2" id="Mobile" placeholder="name@example.com">
            <label for="Mobile"><i class="fa-solid fa-phone"></i> Mobile No<span>*</span></label>
          </div>
          <div class="form-floating mb-2">
            <%let date = new Date().getFullYear() + '-' + (Number(new Date().getMonth()) + 1).toString().padStart(2,'0') + '-' + new Date().getDate().toString().padStart(2,'0') %>
            <input type="date" class="form-control" id="AppointmentDate" placeholder="name@example.com" onchange="setFees()"
              value="<%=date%>">
            <label for="Fees"><i class="fa-solid fa-calendar"></i> Appointment Date <span>*</span></label>
          </div>
          <div class="form-floating mb-2">
            <input type="text" class="form-control" id="IdProof" placeholder="name@example.com">
            <label for="IdProof"><i class="fa-solid fa-id-badge"></i> Id proof </label>
          </div>

          <div class="form-floating">
            <select class="form-select" id="paymentType" aria-label="Floating label select example">
              <option selected disabled value="">--Select--</option>
              <option value="Cash">Cash</option>
              <option value="Online">Online</option>
              <option value="NA">NA</option>
            </select>
            <label for="Gender"><i class="fa-solid fa-user-doctor"></i> Payment Type <span>*</span></label>
          </div>
        </div>
      </div>
      <div style="padding-top: 10px;">
        <button id="register" class="btn" style="background-color:#025E73; width: 35%;" type="submit" value=""
          onclick="registerPatient()"><i class="fas fa-user-plus"></i> Register</button>
        <button id="bookAppointment" style="width: 35%;" disabled class="btn btn-success" type="submit"
          onclick="bookAppointmentWithId()"><i class="fas fa-calendar-check"></i> Book Appointment</button>
      </div>
    </div>


  </section>

  <div style="display: block;position: fixed;top: 23%; left: 80%;">
    Last Visit Date : <span id="lastVisitDate">NA</span>
    <br>
    Last Fees Paid : <span id="lastFeesPaid">NA</span>
  </div>

</body>


</html>
